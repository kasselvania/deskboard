DESKBOARD_APPLE_BRIDGE_ID=<opaque-bridge-id>
DESKBOARD_APPLE_BRIDGE_TOKEN=<64-lowercase-hex-token>
DESKBOARD_APPLE_MIRROR_DATABASE_PATH=/var/lib/deskboard/<private-database-file>.sqlite
DESKBOARD_BOARD_MODE=apple-mirror
DESKBOARD_BOARD_TIME_ZONE=<owner-supplied-IANA-zone>
DESKBOARD_PROXY_BIND_PORT=8080
